# Canonical production URL (no trailing slash). Required for correct canonicals,
# sitemap and structured data, e.g. https://www.yourdomain.com
NEXT_PUBLIC_SITE_URL=

# --- Estimate form delivery (server-side only; never prefix with NEXT_PUBLIC_) ---
# Resend API key (https://resend.com). The ONLY required setting for the form.
# Create the Resend account with Enzosconcretellc@gmail.com so the default sender can deliver to it.
RESEND_API_KEY=
# Optional. Where estimate requests go (comma-separate several). Default: the email shown on the site.
LEAD_TO_EMAIL=
# Optional. Default: "Enzo's Concrete Website <onboarding@resend.dev>", Resend's test sender, which
# only delivers to the Resend account owner's address. After verifying the site's domain in Resend,
# set e.g. "Enzo's Concrete Website <estimates@yourdomain.com>" to send from your own domain.
LEAD_FROM_EMAIL=

# --- Analytics (optional; nothing loads when blank) ---
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token (content value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Indexing ---
# Set to true to keep a deploy out of search results. *.netlify.app / *.vercel.app
# addresses are already noindexed automatically; the real domain is indexed.
SITE_NOINDEX=
