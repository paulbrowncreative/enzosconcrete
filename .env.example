# Canonical production URL (no trailing slash). Required for correct canonicals,
# sitemap and structured data, e.g. https://www.yourdomain.com
NEXT_PUBLIC_SITE_URL=

# --- Estimate form delivery (server-side only; never prefix with NEXT_PUBLIC_) ---
# Resend API key: https://resend.com (free tier covers typical lead volume)
RESEND_API_KEY=
# Where new estimate requests are delivered
LEAD_TO_EMAIL=Enzosconcretellc@gmail.com
# Sender on a domain verified in Resend, e.g. "Enzo's Concrete Website <estimates@yourdomain.com>"
LEAD_FROM_EMAIL=

# --- Analytics (optional; nothing loads when blank) ---
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token (content value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Indexing ---
# Set to true to keep a deploy out of search results. *.netlify.app / *.vercel.app
# addresses are already noindexed automatically; the real domain is indexed.
SITE_NOINDEX=
